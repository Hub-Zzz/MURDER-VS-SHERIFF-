local function makeSlider(parent, labelText, minV, maxV, defaultV, onChange)
	local row = new("Frame", { Size = UDim2.new(1, 0, 0, 50), BackgroundTransparency = 1 }, parent)

	new("TextLabel", {
		Size = UDim2.new(1, -70, 0, 18),
		BackgroundTransparency = 1,
		Text = labelText,
		Font = Enum.Font.GothamMedium,
		TextSize = 14,
		TextColor3 = CONFIG.Text,
		TextXAlignment = Enum.TextXAlignment.Left,
	}, row)

	local track = new("Frame", {
		Size = UDim2.new(1, -110, 0, 6),
		Position = UDim2.fromOffset(0, 30),
		BackgroundColor3 = Color3.fromRGB(58, 58, 63),
		BorderSizePixel = 0,
	}, row)
	corner(track, 4)

	local fill = new("Frame", { Size = UDim2.new(0, 0, 1, 0), BackgroundColor3 = CONFIG.Accent, BorderSizePixel = 0 }, track)
	corner(fill, 4)

	local knob = new("Frame", {
		Size = UDim2.fromOffset(14, 14),
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.new(0, 0, 0.5, 0),
		BackgroundColor3 = Color3.new(1, 1, 1),
		BorderSizePixel = 0,
	}, track)
	corner(knob, 7)

	local badge = new("Frame", {
		Size = UDim2.fromOffset(26, 26),
		Position = UDim2.new(1, -26, 0, 18),
		BackgroundColor3 = CONFIG.Accent,
		BorderSizePixel = 0,
	}, row)
	corner(badge, 13)

	local badgeText = new("TextLabel", {
		Size = UDim2.new(1, 0, 1, 0),
		BackgroundTransparency = 1,
		Text = tostring(defaultV),
		Font = Enum.Font.GothamBold,
		TextSize = 12,
		TextColor3 = Color3.new(1, 1, 1),
	}, badge)

	local value = defaultV
	local dragging = false

	local function apply(alpha, fire)
		alpha = math.clamp(alpha, 0, 1)
		value = math.floor(minV + (maxV - minV) * alpha + 0.5)
		fill.Size = UDim2.new(alpha, 0, 1, 0)
		knob.Position = UDim2.new(alpha, 0, 0.5, 0)
		badgeText.Text = tostring(value)
		if fire then pcall(onChange, value) end
	end

	track.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1
			or input.UserInputType == Enum.UserInputType.Touch then
			dragging = true
			apply((input.Position.X - track.AbsolutePosition.X) / track.AbsoluteSize.X, true)
		end
	end)

	UserInputService.InputChanged:Connect(function(input)
		if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement
			or input.UserInputType == Enum.UserInputType.Touch) then
			apply((input.Position.X - track.AbsolutePosition.X) / track.AbsoluteSize.X, true)
		end
	end)

	UserInputService.InputEnded:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1
			or input.UserInputType == Enum.UserInputType.Touch then
			dragging = false
		end
	end)

	apply((defaultV - minV) / (maxV - minV), false)
	return row
end

local function makeToggle(parent, labelText, default, onChange)
	local row = new("Frame", { Size = UDim2.new(1, 0, 0, 34), BackgroundTransparency = 1 }, parent)

	new("TextLabel", {
		Size = UDim2.new(1, -60, 0, 34),
		BackgroundTransparency = 1,
		Text = labelText,
		Font = Enum.Font.GothamMedium,
		TextSize = 14,
		TextColor3 = CONFIG.Text,
		TextXAlignment = Enum.TextXAlignment.Left,
	}, row)

	local btn = new("Frame", {
		Size = UDim2.fromOffset(44, 22),
		Position = UDim2.new(1, -44, 0.5, -11),
		BackgroundColor3 = Color3.fromRGB(52, 52, 57),
		BorderSizePixel = 0,
	}, row)
	corner(btn, 11)

	local dot = new("Frame", {
		Size = UDim2.fromOffset(16, 16),
		Position = UDim2.fromOffset(3, 3),
		BackgroundColor3 = Color3.fromRGB(200, 200, 205),
		BorderSizePixel = 0,
	}, btn)
	corner(dot, 8)

	local active = default

	local function render(anim)
		local goalPos = active and UDim2.new(1, -19, 0, 3) or UDim2.fromOffset(3, 3)
		local goalCol = active and CONFIG.Accent or Color3.fromRGB(200, 200, 205)
		if anim then
			TweenService:Create(dot, TweenInfo.new(0.15), { Position = goalPos, BackgroundColor3 = goalCol }):Play()
		else
			dot.Position = goalPos
			dot.BackgroundColor3 = goalCol
		end
	end

	new("TextButton", {
		Size = UDim2.new(1, 0, 1, 0),
		BackgroundTransparency = 1,
		Text = "",
	}, btn).MouseButton1Click:Connect(function()
		active = not active
		render(true)
		pcall(onChange, active)
	end)

	render(false)
	return row
end

