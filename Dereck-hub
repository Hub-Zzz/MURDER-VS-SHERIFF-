local coinRemote
task.spawn(function()
	for _, d in pairs(ReplicatedStorage:GetDescendants()) do
		if d:IsA("RemoteEvent") and string.find(string.lower(d.Name), "coin") then
			coinRemote = d
			break
		end
	end
end)

task.spawn(function()
	while gui.Parent do
		if state.autoCoins then
			for _, d in pairs(workspace:GetDescendants()) do
				if d.Name == "Coin" then
					if coinRemote then
						pcall(function() coinRemote:FireServer(d) end)
					else
						local prompt = d:FindFirstChildOfClass("ProximityPrompt", true)
						if prompt then pcall(function() prompt:InputHoldBegin() end) end
					end
				end
			end
		end
		task.wait(0.25)
	end
end)

task.spawn(function()
	while gui.Parent do
		if state.autoKill then
			local ch = LP.Character
			local tool = ch and ch:FindFirstChildOfClass("Tool")
			if tool and tool.Name == "Knife" then
				local root = ch:FindFirstChild("HumanoidRootPart")
				if root then
					local best, dist = nil, 14
					for _, plr in pairs(Players:GetPlayers()) do
						if plr ~= LP and plr.Character then
							local r = plr.Character:FindFirstChild("HumanoidRootPart")
							local h = plr.Character:FindFirstChildOfClass("Humanoid")
							if r and h and h.Health > 0 then
								local d = (r.Position - root.Position).Magnitude
								if d < dist then best, dist = plr, d end
							end
						end
					end
					if best then pcall(function() tool:Activate() end) end
				end
			end
		end
		task.wait(0.1)
	end
end)

