local COLORS = {
	murderer = Color3.fromRGB(235, 45, 45),
	sheriff  = Color3.fromRGB(60, 140, 255),
	coin     = Color3.fromRGB(255, 200, 40),
}

local function highlight(inst, color)
	local h = Instance.new("Highlight")
	h.FillColor = color
	h.FillTransparency = 0.55
	h.OutlineColor = color
	h.OutlineTransparency = 0
	h.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
	h.Parent = inst
	return h
end

-- busca el rol también en la mochila, no solo en el personaje
local function roleOf(plr)
	local list = {}
	if plr.Character then
		for _, t in pairs(plr.Character:GetChildren()) do table.insert(list, t) end
	end
	local bp = plr:FindFirstChildOfClass("Backpack")
	if bp then
		for _, t in pairs(bp:GetChildren()) do table.insert(list, t) end
	end
	for _, t in pairs(list) do
		if t:IsA("Tool") then
			if t.Name == "Knife" then return "murderer" end
			if t.Name == "Gun" then return "sheriff" end
		end
	end
	return nil
end

local espPlayers, espCoins = {}, {}

local function clearTbl(t)
	for k, h in pairs(t) do
		if h then h:Destroy() end
		t[k] = nil
	end
end

task.spawn(function()
	while gui.Parent do
		for _, plr in pairs(Players:GetPlayers()) do
			if plr ~= LP then
				local ch = plr.Character
				local role = roleOf(plr)
				local want = ch and ((role == "murderer" and state.espMurderer)
					or (role == "sheriff" and state.espSheriff))
				if want then
					if not espPlayers[ch] then espPlayers[ch] = highlight(ch, COLORS[role]) end
				elseif ch and espPlayers[ch] then
					espPlayers[ch]:Destroy()
					espPlayers[ch] = nil
				end
			end
		end
		for inst, h in pairs(espPlayers) do
			if not inst.Parent then h:Destroy(); espPlayers[inst] = nil end
		end

		if state.espCoins then
			for _, d in pairs(workspace:GetDescendants()) do
				if d.Name == "Coin" and not espCoins[d]
					and (d:IsA("BasePart") or d:IsA("Model")) then
					espCoins[d] = highlight(d, COLORS.coin)
				end
			end
			for inst, h in pairs(espCoins) do
				if not inst.Parent then h:Destroy(); espCoins[inst] = nil end
			end
		elseif next(espCoins) then
			clearTbl(espCoins)
		end

		task.wait(0.5)
	end
end)

